{
  "$defs": {
    "BlobRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "title": "BlobRef",
      "type": "object"
    },
    "Note": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "minLength": 1,
          "title": "Author",
          "type": "string"
        },
        "t": {
          "$ref": "#/$defs/Timestamp"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "t",
        "text",
        "author"
      ],
      "title": "Note",
      "type": "object"
    },
    "RunKind": {
      "enum": [
        "sim",
        "real",
        "hil"
      ],
      "title": "RunKind",
      "type": "string"
    },
    "Timestamp": {
      "additionalProperties": false,
      "description": "Monotonic nanoseconds plus optional offset to wall-clock time (UTC epoch ns).",
      "properties": {
        "mono_ns": {
          "minimum": 0,
          "title": "Mono Ns",
          "type": "integer"
        },
        "wall_offset_ns": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wall Offset Ns"
        }
      },
      "required": [
        "mono_ns"
      ],
      "title": "Timestamp",
      "type": "object"
    },
    "VersionRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "object_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Object Id",
          "type": "string"
        },
        "semver": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
          "title": "Semver",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "semver",
        "content_hash"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assembly": {
      "$ref": "#/$defs/VersionRef"
    },
    "bundle": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "car": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Car"
    },
    "controller": {
      "$ref": "#/$defs/VersionRef"
    },
    "file": {
      "$ref": "#/$defs/BlobRef"
    },
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/RunKind"
    },
    "notes": {
      "items": {
        "$ref": "#/$defs/Note"
      },
      "title": "Notes",
      "type": "array"
    },
    "race_setup_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Race Setup Id"
    },
    "schema": {
      "const": "runlog",
      "default": "runlog",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "started": {
      "$ref": "#/$defs/Timestamp"
    },
    "track": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "kind",
    "assembly",
    "controller",
    "started",
    "file"
  ],
  "title": "RunLog",
  "type": "object"
}
