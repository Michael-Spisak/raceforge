    "TrackScout is free and open source (GPL-3.0). It only talks to your own RaceForge backend.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TrackScout ist kostenlos und Open Source (GPL-3.0). Es spricht nur mit eurem eigenen RaceForge-Backend."
          }
        }
      }
    },
    "TrackScout needs an iPhone or iPad with a LiDAR scanner (iPhone 12 Pro or newer Pro models, iPad Pro).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
