# Copy to deploy/.env (git-ignored) and fill in. Never commit real values (ADR-0009).

# Image and versions (raceforge-admin update rewrites the two tags)
RF_IMAGE=ghcr.io/michael-spisak/raceforge-backend
RF_TAG_BLUE=dev
RF_TAG_GREEN=dev

# Public address the invite links point to, and the Caddy site address(es)
RF_PUBLIC_URL=https://raceforge.example.org
RF_SITE_ADDRESS=raceforge.example.org, raceforge.your-tailnet.ts.net
RF_HTTP_PORT=80
RF_HTTPS_PORT=443
RF_SECURE_COOKIES=true

# Secrets: generate with `openssl rand -hex 32`
RF_POSTGRES_PASSWORD=change-me
RF_S3_ACCESS_KEY=raceforge
RF_S3_SECRET_KEY=change-me

# Cloudflare Tunnel (only with `--profile cloudflare`)
RF_CLOUDFLARE_TUNNEL_TOKEN=

# Backups (raceforge-admin backup): restic repository + password.
# Offsite on a teammate PC over Tailscale, e.g. rest:http://teammate-pc:8000/raceforge or sftp:…
RESTIC_REPOSITORY=/srv/raceforge-backups
RESTIC_PASSWORD=change-me
